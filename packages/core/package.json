{
  "dependencies": {
    "bcrypt": "^5.1.1",
    "uuid": "^10.0.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "exports": {
    "import": "./lib/index.js",
    "require": "./lib/index.cjs"
  },
  "main": "./lib/index.js",
  "name": "@ts-api-example/core",
  "scripts": {
    "build": "tsup ./src/index.ts --dts --format esm,cjs --out-dir ./lib --tsconfig tsconfig.build.json",
    "build:watch": "pnpm build --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --ext ts --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./lib/index.d.ts"
}